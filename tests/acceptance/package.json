{
    "name": "@hpcc-js/wasm-acceptance-tests",
    "version": "1.0.0",
    "description": "Spec-driven acceptance tests (test cases -> DSL -> protocol drivers -> system under test)",
    "private": true,
    "type": "module",
    "scripts": {
        "lint-eslint": "eslint \"src/**/*.{ts,mjs}\" \"graphviz/**/*.ts\" \"graphviz-cli/**/*.ts\" \"util/**/*.ts\"",
        "lint-specs": "node ../../scripts/check-spec-coverage.mjs",
        "lint-types": "tsc --noEmit -p tsconfig.json",
        "lint": "run-p lint-eslint lint-specs",
        "test-browser": "vitest run --project browser",
        "test-node": "vitest run --project node",
        "test": "vitest run"
    },
    "devDependencies": {
        "@hpcc-js/wasm-graphviz": "1.30.0",
        "@hpcc-js/wasm-graphviz-cli": "1.11.4",
        "@hpcc-js/wasm-util": "1.0.0"
    }
}
